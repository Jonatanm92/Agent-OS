{
  "name": "agent-os",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, vendor-neutral mission control for coding agents, local memory, auditable workflows, and project-scoped tools.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm run build && npm start -w server",
    "serve": "npm start -w server",
    "cli": "node bin/agentos.mjs",
    "test": "npm test -w server"
  },
  "bin": {
    "agentos": "bin/agentos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonatanm92/Agent-OS.git"
  },
  "homepage": "https://github.com/Jonatanm92/Agent-OS#readme",
  "bugs": {
    "url": "https://github.com/Jonatanm92/Agent-OS/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "self-hosted",
    "agent-orchestration",
    "claude-code",
    "codex",
    "obsidian",
    "developer-tools"
  ]
}
