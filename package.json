{
  "name": "agent-os",
  "version": "1.0.0",
  "private": true,
  "description": "Hermes Oracle Company OS — a governed AI software factory and owner control plane",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm run build && npm start -w server",
    "serve": "npm start -w server",
    "cli": "node bin/agentos.mjs",
    "validate:company": "node scripts/validate-company-package.mjs",
    "test": "npm run validate:company && npm test -w server"
  },
  "bin": {
    "agentos": "bin/agentos.mjs"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "body-parser": "1.20.6"
  }
}
