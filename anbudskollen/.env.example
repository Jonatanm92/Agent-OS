# Kopiera till .env och fyll i. Alla värden är valfria utom där det står annat.

# --- Webbadress och port ---
PORT=3020
# Den publika adressen (används i Stripe-länkar). Ex: https://anbudskollen.se
PUBLIC_URL=

# --- Ägarpanel (/admin.html) – sätt en lång slumpmässig sträng ---
ADMIN_TOKEN=

# --- AI-analys (Claude). Utan nyckel körs ett demoläge utan AI. ---
# Skapa nyckel på https://platform.claude.com och sätt en månadsbudget där.
ANTHROPIC_API_KEY=
# Standard: claude-opus-5-5 (bäst kvalitet). claude-sonnet-5-5 ger ungefär halva kostnaden.
ANALYS_MODELL=claude-opus-5-5
ANALYS_EFFORT_EXTRAKTION=medium
ANALYS_EFFORT_SYNTES=high
# Sätt till "off" om trafiken går via en proxy som inte stöder fallback-betan.
ANALYS_FALLBACKS=default

# --- Betalning ---
# Stripe secret key (sk_live_... eller sk_test_...). Tomt = ingen kortbetalning.
STRIPE_SECRET_KEY=
PRIS_SEK=995
PRIS_TEXT=995 kr exkl. moms
MOMS_TEXT=Priset är exklusive moms.
# Låt kunder begära faktura (du låser upp i ägarpanelen).
FAKTURA_AKTIVERAD=true
# true = alla rapporter är gratis och upplåsta (för egna piloter).
GRATISLAGE=false

# --- Säljarens uppgifter (visas i villkor, integritetspolicy och sidfot) ---
VARUMARKE=Anbudskollen
FORETAGSNAMN=
ORGANISATIONSNUMMER=
FORETAGSADRESS=
KONTAKT_EPOST=

# --- Kostnadsskydd ---
GRATIS_ANALYSER_PER_IP_OCH_DYGN=2
MAX_ANALYSER_PER_DYGN=40
MAX_SAMTIDIGA_JOBB=2
MAX_FILER=15
MAX_FILSTORLEK_MB=30

# --- Lagring ---
DATA_DIR=./data
LAGRINGSTID_DAGAR=365
