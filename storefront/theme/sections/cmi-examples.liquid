{% comment %}
  cmi-examples.liquid — 4 to 8 example / mockup images.

  Placeholder policy: a block with no image renders a clearly-worded placeholder
  panel that says outright it is a placeholder. Nothing here is allowed to imply
  a real example exists when it does not, and the launch checklist blocks going
  live while any placeholder is still visible.

  Rights policy (repeated in the theme editor `info` text): only artwork this
  store owns or has licensed may go here. No artist photography, tour artwork,
  band logos, album covers, or ticketing-company trade dress.
{% endcomment %}

{% render 'cmi-css' %}

{%- assign placeholder_count = 0 -%}
{%- for block in section.blocks -%}
  {%- unless block.settings.image -%}{%- assign placeholder_count = placeholder_count | plus: 1 -%}{%- endunless -%}
{%- endfor -%}

<section class="cmi cmi--dark cmi__section" id="cmi-examples" aria-labelledby="cmi-ex-heading-{{ section.id }}">
  <div class="cmi__wrap">
    <p class="cmi__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="cmi__h2" id="cmi-ex-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="cmi__lede">{{ section.settings.intro | escape }}</p>

    {%- if placeholder_count > 0 -%}
      <p class="cmi__placeholder-banner" role="note">
        Demo placeholders in use — {{ placeholder_count }} of {{ section.blocks.size }} panels have no image yet.
        Replace them in the theme editor before launch.
      </p>
    {%- endif -%}

    <div class="cmi__grid cmi__grid--2 cmi__examples">
      {%- for block in section.blocks -%}
        <figure class="cmi__example" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                      {{ block.settings.image | image_url: width: 800 }} 800w"
              sizes="(min-width: 750px) 50vw, 100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.caption | escape }}"
              loading="lazy"
              decoding="async">
          {%- else -%}
            <div class="cmi__example-ph" role="img"
                 aria-label="Placeholder for {{ block.settings.caption | escape | default: 'an example page' }}. No demo image has been added yet.">
              {%- comment -%}
                Only the badge goes inside the tile — the <figcaption> below
                already names the page, so repeating it here reads as a bug.
              {%- endcomment -%}
              <span class="cmi__example-ph-tag">Placeholder</span>
            </div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="cmi__muted">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.rights_note != blank -%}
      <p class="cmi__muted" style="margin-top:18px;">{{ section.settings.rights_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  /* Two up on mobile. At one column each 3:4 tile is ~700px tall, which turns
     eight examples into 5,600px of scroll on a phone. */
  .cmi .cmi__examples { grid-template-columns: 1fr 1fr; gap: 12px; }
  .cmi .cmi__example { margin: 0; }
  .cmi .cmi__example img { border-radius: 10px; width: 100%; }
  .cmi .cmi__example figcaption { margin-top: 8px; font-size: 0.8125rem; }
  .cmi .cmi__example-ph {
    aspect-ratio: 3 / 4;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px; padding: 16px; text-align: center;
    border: 2px dashed var(--cmi-line-dark);
    border-radius: 10px;
    background: repeating-linear-gradient(45deg, #17171D 0 10px, #1B1B21 10px 20px);
  }
  .cmi .cmi__example-ph-tag {
    font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
    padding: 4px 10px; border-radius: 999px;
    background: var(--cmi-accent); color: #16110E;
  }
  .cmi .cmi__example-ph-text { font-family: var(--cmi-display); font-size: 1rem; color: var(--cmi-muted-on-dark); }
  .cmi .cmi__placeholder-banner {
    margin: 0 0 18px; padding: 12px 14px;
    border: 1px solid var(--cmi-accent); border-radius: 10px;
    background: rgba(242, 112, 58, 0.10);
    color: var(--cmi-paper); font-size: 0.875rem; font-weight: 600;
  }
  @media (min-width: 750px) { .cmi .cmi__examples { grid-template-columns: repeat(4, 1fr); } }
</style>

{% schema %}
{
  "name": "CMI Examples",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Example pages" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the finished issue looks like." },
    {
      "type": "textarea", "id": "intro", "label": "Intro",
      "default": "Your issue is designed around your own photos, so no two look alike. These pages show the layout and the level of finish."
    },
    {
      "type": "textarea", "id": "rights_note", "label": "Rights note",
      "default": "Example pages are our own demonstration designs. They do not show any real artist's photography, artwork or branding."
    }
  ],
  "blocks": [
    {
      "type": "example", "name": "Example page",
      "settings": [
        {
          "type": "image_picker", "id": "image", "label": "Image",
          "info": "Use only artwork you own or have licensed. Never upload artist photography, tour artwork, band logos, album covers or ticketing-company branding. Leave blank to show a labelled placeholder."
        },
        { "type": "text", "id": "caption", "label": "Caption / alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CMI Examples",
      "blocks": [
        { "type": "example", "settings": { "caption": "Cover" } },
        { "type": "example", "settings": { "caption": "Night and show details" } },
        { "type": "example", "settings": { "caption": "Souvenir ticket page" } },
        { "type": "example", "settings": { "caption": "Photo spread" } },
        { "type": "example", "settings": { "caption": "Atmosphere spread" } },
        { "type": "example", "settings": { "caption": "Setlist and highlights" } },
        { "type": "example", "settings": { "caption": "Your favourite memory" } },
        { "type": "example", "settings": { "caption": "Closing page" } }
      ]
    }
  ]
}
{% endschema %}
