{% comment %}
  cmi-before-after.liquid — the transformation, stated plainly.
  Two stacked cards on mobile, side by side from 750px. The arrow between them is
  inline SVG (no image request) and is aria-hidden because the headings carry the meaning.
{% endcomment %}

{% render 'cmi-css' %}

<section class="cmi cmi--light cmi__section" aria-labelledby="cmi-ba-heading-{{ section.id }}">
  <div class="cmi__wrap">
    <p class="cmi__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="cmi__h2" id="cmi-ba-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

    <div class="cmi__grid cmi__grid--2 cmi__ba">
      <div class="cmi__card">
        <h3 class="cmi__h3">{{ section.settings.before_title | escape }}</h3>
        <ul class="cmi__list">
          {%- assign before_items = section.settings.before_items | newline_to_br | split: '<br />' -%}
          {%- for item in before_items -%}
            {%- assign line = item | strip -%}
            {%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="cmi__card cmi__card--after">
        <h3 class="cmi__h3">{{ section.settings.after_title | escape }}</h3>
        <p>{{ section.settings.after_text | escape }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scoped to this section only. */
  .cmi .cmi__ba .cmi__card--after { background: var(--cmi-ink); color: var(--cmi-paper); border-color: var(--cmi-ink); }
  .cmi .cmi__ba .cmi__card--after .cmi__h3 { color: var(--cmi-accent); }
</style>

{% schema %}
{
  "name": "CMI Before / After",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before and after" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scattered pieces of a night, into one thing you keep." },
    { "type": "text", "id": "before_title", "label": "Before title", "default": "Before" },
    {
      "type": "textarea", "id": "before_items", "label": "Before items (one per line)",
      "default": "Ticket screenshot.\nCamera roll.\nSetlist.\nA few memories."
    },
    { "type": "text", "id": "after_title", "label": "After title", "default": "After" },
    {
      "type": "textarea", "id": "after_text", "label": "After text",
      "default": "One finished keepsake that tells the story of the night."
    }
  ],
  "presets": [{ "name": "CMI Before / After" }]
}
{% endschema %}
