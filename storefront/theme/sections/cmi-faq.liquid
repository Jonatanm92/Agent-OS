{% comment %}
  cmi-faq.liquid — FAQ built on native <details>/<summary>.

  No JavaScript: <details> is keyboard operable, screen-reader announced, and
  open/close state works with JS disabled. It is also searchable by the browser's
  find-in-page in current browsers.

  Turnaround-time policy: no answer here states a number of days. The delivery
  estimate is a single section setting the owner fills in once they have decided
  it, and until then the copy says the estimate is shown before ordering.
{% endcomment %}

{% render 'cmi-css' %}

<section class="cmi cmi--light cmi__section" id="cmi-faq" aria-labelledby="cmi-faq-heading-{{ section.id }}">
  <div class="cmi__wrap">
    <p class="cmi__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="cmi__h2" id="cmi-faq-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

    <div class="cmi__faq">
      {%- for block in section.blocks -%}
        <details class="cmi__faq-item" {{ block.shopify_attributes }}>
          <summary class="cmi__faq-q">{{ block.settings.question | escape }}</summary>
          <div class="cmi__faq-a">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cmi .cmi__faq { border-top: 1px solid var(--cmi-line-light); }
  .cmi .cmi__faq-item { border-bottom: 1px solid var(--cmi-line-light); }
  .cmi .cmi__faq-q {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    /* 56px tall tap target */
    padding: 18px 2px;
    min-height: 56px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.4;
  }
  .cmi .cmi__faq-q::-webkit-details-marker { display: none; }
  .cmi .cmi__faq-q::after {
    content: "";
    flex: 0 0 auto;
    width: 13px; height: 13px;
    border-right: 2px solid var(--cmi-accent-dim);
    border-bottom: 2px solid var(--cmi-accent-dim);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.15s ease;
  }
  .cmi .cmi__faq-item[open] .cmi__faq-q::after { transform: rotate(-135deg) translate(-4px, -4px); }
  .cmi .cmi__faq-a { padding: 0 2px 20px; font-size: 0.9375rem; color: var(--cmi-muted-on-light); }
  .cmi .cmi__faq-a p { margin: 0 0 10px; }
  .cmi .cmi__faq-a p:last-child { margin-bottom: 0; }
</style>

{% schema %}
{
  "name": "CMI FAQ",
  "tag": "div",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you order" }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        {
          "type": "richtext", "id": "answer", "label": "Answer",
          "info": "Do not state a turnaround time here that you have not committed to honouring."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CMI FAQ",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "How do I send my photos?",
            "answer": "<p>Two ways, and you choose in the order form. Either paste a share link from Google Drive, Dropbox, iCloud or WeTransfer, or pick the option to email them after ordering — we reply with an address to send them to as soon as your order is confirmed. You can also attach your ticket screenshot directly to the form.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How long does it take?",
            "answer": "<p>Every issue is designed by hand, so the time depends on the queue and on how much material you send. The current production estimate is shown before you order, and we confirm it again in your order email.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Can I use a concert from years ago?",
            "answer": "<p>Yes. Age makes no difference — old photos and half-remembered details are often the best material. An approximate date is fine.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What if I no longer have the ticket?",
            "answer": "<p>That is fine, and common. The ticket upload is optional. We design the souvenir-style page from the details you give us instead — artist, venue, city, date and seat or section if you remember it.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Can I request changes?",
            "answer": "<p>The Full Issue edition includes one round of revisions. On One Night we will still fix anything we got wrong — a misspelled name, a wrong date, the wrong photo — at no charge.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Is this official artist merchandise?",
            "answer": "<p>No. This is a personalized fan keepsake made from material you supply. It is not official artist, venue, promoter or ticketing-company merchandise, and it is not affiliated with, licensed by or endorsed by any of them.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Can I order a printed version?",
            "answer": "<p>Not yet. Both editions are delivered as a digital file at the moment. The file is prepared at a resolution suitable for printing at home or at a print shop, and printed editions are something we are looking at once we know there is demand for them.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What image quality should I upload?",
            "answer": "<p>Send the originals straight from your phone or camera rather than screenshots or images saved from a chat app, which are compressed. Larger files are better. Dark, grainy concert photos are expected and usually work well — send them even if you think they are too dark, and we will tell you if something genuinely cannot be used.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
