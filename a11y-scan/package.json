{
  "name": "a11y-risk-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "E-commerce Accessibility Risk Scan \u2014 bounded, safety-first pre-audit tooling for Swedish e-commerce.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "full-scan": "tsx src/cli.ts scan",
    "prescan": "tsx src/cli.ts prescan",
    "fixture-server": "tsx fixtures/serve.ts",
    "examples": "tsx gen-examples.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axe-core": "^4.10.2",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
