# Required for AI imports (social captions, pasted text, photos). Website imports with
# schema.org Recipe markup work without it.
ANTHROPIC_API_KEY=
# Model used for AI extraction.
JARFUL_MODEL=claude-opus-5
PORT=8787
# Public base URL (used for Stripe redirect links).
PUBLIC_URL=http://localhost:8787
# Stripe (optional until you charge). Create Payment Links in the Stripe dashboard and
# set the success URL to {PUBLIC_URL}/?upgraded=1. Add ?client_reference_id is appended automatically.
STRIPE_LINK_MONTHLY=
STRIPE_LINK_YEARLY=
STRIPE_LINK_LIFETIME=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_URL=
# Free-tier AI imports per calendar month.
FREE_AI_IMPORTS=20
